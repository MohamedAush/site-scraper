    {
      "id": "publication-13647",
      "source_type": "އުސޫލުތައް",
      "published_at": "2018-04-10T05:06:18Z",
      "translations": {
        "dv": {
          "title": "ދީނީ މިނިވަންކަމާއި، ދީނަށް މަލާމާތްކުރުމާއި، ހަނގުރާމައަށް ދިޔުމާއި، ދީނުގެ ނަމުގައި ހިންގާ މާރާމާރީއާއި، ހަނގުރާމަވެރި ޙަރަކާތްތައް ހިންގުމާބެހޭ މައްސަލަތަކުގައި ބައިވެރިވާ ފަރާތްތަކާމެދު ޢަމަލުކުރުމަށް އެކުލަވައިލެވިފައިވާ އުސޫލު"
        }
      },
