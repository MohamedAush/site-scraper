    {
      "id": "announcement-18609",
      "source_type": "Business",
      "category_slug": "business",
      "published_at": "2024-07-24T08:13:56Z",
      "reference_number": null,
      "deadline": null,
      "featuredImage": {
        "url": "https://trade.gov.mv/wp-content/uploads/producers_registry.jpg",
        "alt": "Register of Maldivian Producers"
      },
      "files": [],
      "translations": {
        "en": {
          "title": "Register of Maldivian Producers",
          "description": "The Ministry is building a registry of Maldivian producers to help them connect to potential buyers in Maldives and internationally. This information will also enable the government to provide targeted support to increase marketability of Maldivian products. If you wish to include your information in the producers register, please fill out the form by clicking… Read More »Register of Maldivian Producers",
          "body": "The Ministry is building a registry of Maldivian producers to help them connect to potential buyers in Maldives and internationally.\n\nThis information will also enable the government to provide targeted support to increase marketability of Maldivian products.\n\nIf you wish to include your information in the producers register, please fill out the form by clicking the “Registration Form” button below, by 15th August 2024.\n\nHave questions? Contact our team at 1500 or email us at business@1500help.mv\n\nRegistration Form",
          "images": [],
          "source_id": 18609,
          "source_url": "https://trade.gov.mv/en/18609/"
        },
        "dv": {
          "title": "ދިވެހިރާއްޖޭގައި އުފައްދާ ތަކެތީގެ ދަފްތަރު އެކުލަވާލުން",
          "description": "އެކި ބާވަތުގެ ތަކެތި ރާއްޖޭގައި ބޭނުންކުރުމަށް ނުވަތަ ރާއްޖެއިން ބޭރަށް އެކްސްޕޯޓުކުރުމަށް އުފައްދާ ފަރާތްތަކުގެ ދަފްތަރެއް އެކުލަވާލުމުގެ މަސައްކަތް މި މިނިސްޓްރީން ކުރަމުންދާތީ، އެ ދަފްތަރުގައި މަޢުލޫމާތު ހިމެނުމަށް ބޭނުންވާ ފަރާތްތަކުން ތިރީގައިވާ ލިންކް މެދުވެރިކޮށް މަޢުލޫމާތު ޙިއްޞާކުރުމަށް ދަންނަވަމެވެ. މި މަޢުލޫމާތު އެއްކުރުމުގެ މައިގަނޑު މަޤްޞަދަކީ، ރާއްޖޭގައި އާމްދަނީ ހޯދުމަށް ތަކެތި އުފައްދާ ފަރާތްތަކުގެ މަޢުލޫމާތާއި ވިޔަފާރި އުޞޫލުން ވިއްކުމަށް ތަކެތި އުފައްދާ ފަރާތްތައް ދެނެގަނެ، އެ ފަރާތްތަކުގެ މަސައްކަތް ކުރިއަރުވައި، ރާއްޖޭގައި ވިއްކުމަށާއި ރާއްޖެއިން… Read More »ދިވެހިރާއްޖޭގައި އުފައްދާ ތަކެތީގެ ދަފްތަރު އެކުލަވާލުން",
          "body": "އެކި ބާވަތުގެ ތަކެތި ރާއްޖޭގައި ބޭނުންކުރުމަށް ނުވަތަ ރާއްޖެއިން ބޭރަށް އެކްސްޕޯޓުކުރުމަށް އުފައްދާ ފަރާތްތަކުގެ ދަފްތަރެއް އެކުލަވާލުމުގެ މަސައްކަތް މި މިނިސްޓްރީން ކުރަމުންދާތީ، އެ ދަފްތަރުގައި މަޢުލޫމާތު ހިމެނުމަށް ބޭނުންވާ ފަރާތްތަކުން ތިރީގައިވާ ލިންކް މެދުވެރިކޮށް މަޢުލޫމާތު ޙިއްޞާކުރުމަށް ދަންނަވަމެވެ.\n\nމި މަޢުލޫމާތު އެއްކުރުމުގެ މައިގަނޑު މަޤްޞަދަކީ، ރާއްޖޭގައި އާމްދަނީ ހޯދުމަށް ތަކެތި އުފައްދާ ފަރާތްތަކުގެ މަޢުލޫމާތާއި ވިޔަފާރި އުޞޫލުން ވިއްކުމަށް ތަކެތި އުފައްދާ ފަރާތްތައް ދެނެގަނެ، އެ ފަރާތްތަކުގެ މަސައްކަތް ކުރިއަރުވައި، ރާއްޖޭގައި ވިއްކުމަށާއި ރާއްޖެއިން ބޭރުގެ މާކެޓްތަކަށް އެކްސްޕޯޓުކުރެވޭނެ އުފެއްދުންތައް ދެނެގަނެ، އެކްސްޕޯޓް ކުރުމުގެ ފުރުޞަތު ރާއްޖެއާއެކު މިނިވަން ވިޔަފާރީގެ އެއްބަސްވުންތަކާއި އެނޫންވެސް ވިޔަފާރީގެ އެއްބަސްވުންތަކަށް ވަދެފައިވާ ޤައުމުތަކުގައި އެ އުފެއްދުންތަކަށް މާކެޓް ހޯދައިދިނުމެވެ. އަދި، މިފަދަ މަސައްކަތްތައް ކުރާ ފަރާތްތަކަށް ކުރިމަތިވާ ގޮންޖެހުންތައް ދެނެގަނެ، ރައީސުލްޖުމްހޫރިއްޔާ ޑރ. މުޙައްމަދު މުޢިއްޒުގެ ސަރުކާރުގެ އެކި ސިޔާސަތުތައް މެދުވެރިކޮށް ދިވެހި މަސައްކަތްތެރިންނަށް ތަކެތި އުފެއްދުމުގައި ކުރިއެރުންތަކެއް ހޯދައިދިނުމަށް އެހީތެރިވުމެވެ.\n\nތަކެތި އުފައްދާ ފަރާތްތަކުގެ ދަފްތަރުގައި މަޢުލޫމާތު ހިމެނުމަށް ބޭނުންފުޅުވާ ފަރާތްތަކުން 15 އޯގަސްޓް 2024 ގެ ކުރިން ތިރީގައިވާ ‘ރަޖިސްޓްރީ ފޯމް’ މެދުވެރިކޮށް މި މިނިސްޓްރީއާ މަޢުލޫމާތު ހިއްސާކޮށްދެއްވުމަށް ދަންނަވަމެވެ.\n\nމި އިޢުލާނާއި ގުޅިގެން އެއްވެސް މަޢުލޫމާތެއް ސާފުކުރަން ބޭނުންފުޅުވާނަމަ، މި މިނިސްޓްރީގެ ކޮންޓެކްޓް ސެންޓަރ 1500 އަށް ގުޅުއްވުމަށް ދަންނަވަމެވެ\n\nރަޖިސްޓްރީ ފޯމް",
          "images": [],
          "source_id": 18617,
          "source_url": "https://trade.gov.mv/18617/"
        }
      }
    },
